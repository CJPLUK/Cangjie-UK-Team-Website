---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const newsEntries: CollectionEntry<"news">[] = await getCollection("news");
    const legacyNumericIds: Record<string, string> = {
        "oniro-team-ocx-2026-recap": "0",
        "gosim-paris-2026-cangjie-ace-model": "1",
        "ocx-2026-talk-now-on-youtube": "2",
        "prof-dan-r-ghica-to-speak-at-ocx-2026": "3",
        "jcst-publication": "4",
        "cangjie-workshop-42-harmonyos-roadmap-2026": "5",
        "happy-chinese-new-year": "6",
        "cangjie-workshop-41-effect-handlers-and-distributed-actor-framework": "7",
        welcome: "8",
        "cangjie-version-104-released": "9",
    };

    const sortedEntries = newsEntries.sort(
        (a: CollectionEntry<"news">, b: CollectionEntry<"news">) => {
            const [dayA, monthA, yearA] = a.data.date.split("/");
            const [dayB, monthB, yearB] = b.data.date.split("/");
            const dateA = new Date(
                parseInt(yearA),
                parseInt(monthA) - 1,
                parseInt(dayA),
            );
            const dateB = new Date(
                parseInt(yearB),
                parseInt(monthB) - 1,
                parseInt(dayB),
            );
            return dateB.getTime() - dateA.getTime();
        },
    );

    return sortedEntries.flatMap((entry: CollectionEntry<"news">) => {
        const paths = [
            {
                params: { id: entry.slug },
                props: { entry },
            },
        ];
        const legacyId = legacyNumericIds[entry.slug];

        if (legacyId) {
            paths.push({
                // Preserve numeric URLs published before stable slugs were used.
                params: { id: legacyId },
                props: { entry },
            });
        }

        return paths;
    });
}

interface Props {
    entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL;
const withBase = (path: string) => {
    if (path === "/") return baseUrl;
    return `${baseUrl}${path.replace(/^\//, "")}`;
};

const formatDate = (dateStr: string) => {
    const [day, month, year] = dateStr.split("/");
    const date = new Date(parseInt(year), parseInt(month) - 1, parseInt(day));
    return date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
};
---

<BaseLayout title="News — The Cangjie Programming Language UK Team" isBlogPage={true}>
    <main class="blog-main news-page-main">
        <div class="blog-main-inner news-page-inner">
            <a
                href={withBase("/news/")}
                class="news-back-link"
                data-news-back-link
                data-news-href={withBase("/news/")}
                data-home-href={withBase("/")}
                >← Back to News</a
            >
            <article class="news-article">
                <header class="news-article-header">
                    <h1 class="news-article-title">{entry.data.title}</h1>
                    <time class="news-article-date" datetime={entry.data.date}
                        >{formatDate(entry.data.date)}</time
                    >
                </header>
                <div class="news-article-body md-window">
                    <div id="news-content" class="news-content">
                        <Content />
                    </div>
                </div>
            </article>
        </div>
    </main>

    <script is:inline data-astro-rerun>
        (() => {
            const updateNewsBackLink = () => {
                const link = document.querySelector("[data-news-back-link]");
                if (!link) return;

                const newsHref = link.getAttribute("data-news-href") || "";
                const homeHref = link.getAttribute("data-home-href") || "";
                let ref = "";

                try {
                    ref = sessionStorage.getItem("navPrevUrl") || "";
                } catch (e) {}
                if (!ref) ref = document.referrer;
                if (!ref) return;

                const normalize = (path) =>
                    (path || "")
                        .replace(/index\.html$/, "")
                        .replace(/\/+$/, "") || "/";

                try {
                    const refUrl = new URL(ref);
                    if (refUrl.origin !== window.location.origin) return;

                    const refPath = normalize(refUrl.pathname);
                    const homePath = normalize(
                        new URL(homeHref, window.location.origin).pathname,
                    );

                    if (refPath === homePath) {
                        link.setAttribute("href", homeHref);
                        link.textContent = "← Back to Home";
                    } else {
                        link.setAttribute("href", newsHref);
                        link.textContent = "← Back to News";
                    }
                } catch (e) {}
            };

            updateNewsBackLink();
            document.addEventListener("astro:page-load", updateNewsBackLink);
        })();
    </script>
</BaseLayout>
